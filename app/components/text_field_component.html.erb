<% id = "#{name}_field" %>

<div class="space-y-1">
  <% if label %>
    <%= tag.label label, for: id, class: "block text-sm font-medium text-brand-700" %>
  <% end %>

  <%= tag.input name: name, id: id, value: value, type: "text",
        class: final_classes, aria_invalid: (state == :error), **html_options.except(:class) %>

  <% if hint %>
    <p class="text-xs <%= state == :error ? "text-destructive-700" : "text-zinc-500" %>">
      <%= hint %>
    </p>
  <% end %>
</div>
